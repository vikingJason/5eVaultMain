properties:
  file.folderName:
    displayName: folder
views:
  - type: table
    name: Table
    filters:
      and:
        - noteType == "downtimeActions"
    order:
      - file.name
      - folderName
    sort:
      - property: file.name
        direction: ASC
      - property: folderName
        direction: ASC
      - property: file.folder
        direction: DESC
    columnSize:
      file.name: 145
